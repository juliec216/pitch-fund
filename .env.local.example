# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Model guarding the fund (any current Claude model id)
MODEL=claude-sonnet-4-6

# Spectrum (from https://app.photon.codes -> project Settings)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# The project's dedicated iMessage line (Business plan). Everyone texts this one
# number, which is what lets the QR code skip signup entirely. Without it the
# site falls back to sending people to the /join name form.
LINE_PHONE=+15551234567

# Total fund in whole US dollars (default 100)
FUND_USD=100

# Where the SQLite file lives (shared by the agent worker and the dashboard)
DB_PATH=./fund.db
